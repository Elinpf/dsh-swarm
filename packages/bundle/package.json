{
  "name": "@elinpf/dsh-swarm-bundle",
  "version": "0.0.1",
  "description": "dsh-swarm 协作能力 bundle：在 dsh-base 之上层叠团队插件行（先 disabled 关 legacy，再 insert）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/swarm.patch.yml": "./presets/swarm.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets/swarm.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/swarm.patch.yml"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@elinpf/dsh-swarm-team-bus": "workspace:*",
    "@elinpf/dsh-swarm-team-compaction": "workspace:*",
    "@elinpf/dsh-swarm-team-completion": "workspace:*",
    "@elinpf/dsh-swarm-team-core": "workspace:*",
    "@elinpf/dsh-swarm-team-distributed": "workspace:*",
    "@elinpf/dsh-swarm-team-human": "workspace:*",
    "@elinpf/dsh-swarm-team-memory": "workspace:*",
    "@elinpf/dsh-swarm-team-prompt": "workspace:*",
    "@elinpf/dsh-swarm-team-review": "workspace:*",
    "@elinpf/dsh-swarm-team-scale-contract": "workspace:*",
    "@elinpf/dsh-swarm-team-scheduler": "workspace:*",
    "@elinpf/dsh-swarm-team-skills": "workspace:*",
    "@elinpf/dsh-swarm-team-transport": "workspace:*",
    "@elinpf/dsh-swarm-team-workspace": "workspace:*",
    "@elinpf/dsh-swarm-tool-swarm": "workspace:*",
    "@elinpf/dsh-swarm-tool-task": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-base": "^0.2.1-rc.3",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-base": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-agent-team": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-tool-agent-team": {
      "optional": true
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
