{
  "name": "dsh-swarm",
  "version": "0.0.1",
  "private": true,
  "description": "DeepSeek Harness 协作能力插件族（骨架 + hello-world 链路）",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "verify": "pnpm run build && node scripts/verify-load.mjs",
    "verify:e2e": "pnpm run build && node scripts/verify-e2e.mjs",
    "verify:wiring": "pnpm run build && node scripts/verify-native-wiring.mjs",
    "verify:durability": "pnpm run build && node scripts/verify-durability.mjs",
    "verify:xproc": "pnpm run build && node scripts/verify-crossprocess.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.17",
    "eslint": "10.3.0",
    "prettier": "2.8.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.11"
  }
}
